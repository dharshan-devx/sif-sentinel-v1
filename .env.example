# Copy to .env for Docker Compose only. Do not commit populated credentials.
POSTGRES_DB=sif_db
POSTGRES_USER=sif
POSTGRES_PASSWORD=replace-with-a-strong-password
# Use the same password, percent-encoded if it contains URL-reserved characters.
DOCKER_DATABASE_URL=postgresql+psycopg://sif:replace-with-a-strong-password@postgres:5432/sif_db
